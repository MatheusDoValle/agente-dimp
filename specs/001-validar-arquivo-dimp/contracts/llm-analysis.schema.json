{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infis:agente-dimp:llm-analysis:1.0.0",
  "title": "Conteudo analitico do modelo, sem metadados operacionais",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "explanations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "findingIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "findingIds",
          "text",
          "evidenceIds"
        ]
      }
    },
    "indications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "text",
          "evidenceIds"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiresHumanReview": {
      "type": "boolean"
    }
  },
  "required": [
    "summary",
    "explanations",
    "indications",
    "limitations",
    "requiresHumanReview"
  ]
}